# Local development. Copy to .env (git-ignored); `npm run dev` and `npm run cli` read it.
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
DATA_DIR=./data
# The household's time zone, an IANA name such as America/Chicago or Europe/London. Without it, UTC.
HOUSEHOLD_TZ=America/Chicago

# Who may sign in: email=Display name, comma-separated.
ALLOWED_USERS=alex@example.com=Alex,sam@example.com=Sam

# Sign-in, simplest: one long password per person (16+ characters, no spaces or commas).
LOGIN_PASSWORDS=alex@example.com=change-me-to-something-long,sam@example.com=and-another-long-one

# Sign-in with Google instead, or as well (Google Cloud > Google Auth Platform > Clients > Web application).
# Authorized redirect URIs: https://<your host>/auth/google/callback and http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed for the nightly snapshot upload and `npm run db:pull`.
R2_ACCOUNT_ID=
R2_BUCKET=tracker-backups
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
R2_READONLY_ACCESS_KEY_ID=
R2_READONLY_SECRET_ACCESS_KEY=
HEALTHCHECKS_URL=

# Photos and sensitive collections: 32 random bytes in base64
# (openssl rand -base64 32). Without it photos are refused and
# nothing can be saved to a sensitive collection. Keep a copy somewhere safe: what it encrypted cannot be opened
# without it, and a database that holds sensitive entries will not start with another key.
FILES_KEY=

# Switches on the Ask box in the web app (and is used by `npm run eval`). Billed to this key for everyone who signs in.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5
# How much the Ask chat's model thinks before it acts: low (the default, quickest), medium, high.
# ASSISTANT_EFFORT=low
