{
  "name": "magpie",
  "version": "1.0.1",
  "description": "A shared household memory you talk to through Claude: an MCP server, SQLite, and a small web app.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "tsc && node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "smoke": "node scripts/smoke.ts",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "db:pull": "node --env-file-if-exists=.env scripts/db-pull.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.19",
    "openid-client": "^6.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "htmx.org": "^2.0.11",
    "jose": "^6.2.18",
    "typescript": "^7.0.2"
  }
}
